<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" alignment="TOP_CENTER" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="io.github.aaroncj1.cashu.wallet.ui.controller.WalletController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Cashu Wallet" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Mint URL:"/>
        <TextField fx:id="mintUrlField" HBox.hgrow="ALWAYS" promptText="https://testnut.cashu.space"/>
        <Button text="Add Mint" onAction="#onAddMint"/>
    </HBox>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Balance:"/>
        <TextField fx:id="balanceMintField" HBox.hgrow="ALWAYS" promptText="Filter by Mint URL (optional)"/>
        <Button text="Check Balance" onAction="#onCheckBalance"/>
    </HBox>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Amount:"/>
        <TextField fx:id="amountField" promptText="Amount in sats"/>
        <Button text="Send Ecash" onAction="#onSend"/>
    </HBox>

    <Label text="Token (Copy/Paste here):"/>
    <TextArea fx:id="tokenArea" prefRowCount="5" wrapText="true"/>
    <Button text="Receive Ecash" onAction="#onReceive" maxWidth="Infinity"/>

    <Label text="Log:"/>
    <TextArea fx:id="logArea" prefRowCount="10" editable="false" wrapText="true"/>

</VBox>
